{
  "name": "planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "description": "Planner — 家族の予定を管理するWebアプリ",
  "scripts": {
    "dev": "node scripts/sync-assets.mjs && vite",
    "build": "node scripts/sync-assets.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "assets:sync": "node scripts/sync-assets.mjs",
    "deploy": "node scripts/sync-assets.mjs && tsc -b && vite build && firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "firebase": "13.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
